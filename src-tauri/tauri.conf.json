{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "snip-ans",
  "version": "0.1.4",
  "identifier": "com.cccake.snip-ans",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SnipAns Settings",
        "width": 800,
        "height": 600,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "SnipAns Overlay",
        "width": 400,
        "height": 200,
        "x": 0,
        "y": 0,
        "alwaysOnTop": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "url": "overlay.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}